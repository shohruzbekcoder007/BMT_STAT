# =============================================================================
# Hermes host agent — starter
# =============================================================================

APP_NAME=unstat
APP_ENV=development
APP_HOST=0.0.0.0
# Lokal ishga tushirishda (python -m app.main) xizmat shu portda turadi.
# Docker'da e'tiborga olinmaydi: konteyner ichida xizmat doim 8080 da.
APP_PORT=7075
# Docker: kompyuterdagi (host) port — brauzer/gateway shu portga ulanadi.
HOST_PORT=7075
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json
TZ=UTC
PYTHONUNBUFFERED=1

# =============================================================================
# LLM — YAGONA almashtirgich: openai | ollama  (vllm | lmstudio ham mumkin)
# =============================================================================
LLM_PROVIDER=vllm

# --- 1-blok: OPENAI (LLM_PROVIDER=openai bo'lganda ishlaydi) ----------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1
# Title/tag/follow-up uchun arzon model
HERMES_TASK_MODEL=gpt-4.1-mini

# --- 2-blok: OLLAMA (LLM_PROVIDER=ollama bo'lganda ishlaydi) ----------------
# vLLM / LM Studio ham shu blok orqali: BASE_URL ni o'sha serverga qarating
OLLAMA_BASE_URL=http://172.16.5.91:8003/v1
OLLAMA_MODEL=qwen3.8-27b
# Title/tag kabi mayda ishlar uchun kichik model (tezroq)
OLLAMA_TASK_MODEL=qwen3:8b
# Ollama kalit so'ramaydi — faqat proxy orqasida bo'lsa to'ldiring
# OLLAMA_API_KEY=

# Task-modelga yo'naltirishni o'chirish uchun false
HERMES_TASK_ROUTING=true

# =============================================================================
# Data Commons MCP — dunyo statistikasi (dc_ vositalari)
# =============================================================================
# Kalit: https://apikeys.datacommons.org (api.datacommons.org domeni, bepul).
# Bo'sh bo'lsa Data Commons vositalari o'chiq; to'ldirilsa `datacommons`
# toolset avtomatik qo'shiladi — HERMES_ENABLED_TOOLSETS ga yozish shart emas.
DC_API_KEY=
# Custom Data Commons nusxasi bo'lsa — uning MCP manzili
DATACOMMONS_MCP_URL=https://api.datacommons.org/mcp
# Server playbook'ini tizim promptiga qo'shish (~10-15 ming belgi)
DATACOMMONS_PLAYBOOK=true
# Server ishga tushishda javob bermasa, qayta urinish oralig'i (soniya)
DATACOMMONS_RETRY_SECONDS=300
DATACOMMONS_TIMEOUT=60

# =============================================================================
# Hermes host
# =============================================================================
HERMES_SYSTEM_PROMPT_PATH=prompts/hermes_coordinator.md
HERMES_ENABLED_TOOLSETS=memory,session_search,skills,todo
# Xavfsiz ro'yxatdan tashqari toolset (terminal, file, code_execution, browser,
# web, delegation, coding, ...) bo'lsa servis ishga TUSHMAYDI — ular prompt
# injection'ga buyruq bajarish yo'lini ochadi. Ataylab kerak bo'lsa: true
ALLOW_UNSAFE_TOOLSETS=false
HERMES_MAX_ITERATIONS=12
HERMES_SESSION_HISTORY_LIMIT=6
HERMES_SKIP_MEMORY=false
HERMES_QUIET_MODE=true
HERMES_SKIP_CONTEXT_FILES=true
# gpt-4.1 reasoning.effort'ni rad etadi; Ollama'da esa think'ni o'chiradi
HERMES_REASONING_ENABLED=false

# Brauzerdan to'g'ridan-to'g'ri ulanish kerak bo'lsa aniq manzil yozing.
# `*` endi rad etiladi: brauzerlar uni credentials bilan qabul qilmaydi.
# Gateway server tomonidan ulanadi - unga CORS umuman kerak emas.
CORS_ORIGINS=
API_WORKERS=1
API_RELOAD=false

# =============================================================================
# Gateway autentifikatsiyasi va ko'p foydalanuvchi
# =============================================================================
# Gateway shu tokenni Authorization: Bearer ... da yuboradi. Bo'sh bo'lsa
# servis ishga tushmaydi (ataylab - unutilgan sozlama ochiq qoldirmasin).
GATEWAY_TOKEN=
# Faqat lokal ishlab chiqish uchun: tokensiz ishlatishga ruxsat
ALLOW_UNAUTHENTICATED=false

# X-User-Id majburiymi. false = hamma bitta umumiy profilni baham ko'radi
# (bitta foydalanuvchili o'rnatma uchun).
HERMES_REQUIRE_USER_ID=true

# Har foydalanuvchiga chegara
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
MAX_MESSAGE_CHARS=8000
